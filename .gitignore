# Novera AI — .gitignore

# Environment / secrets
.env
.env.*
!.env.example
*.secret
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.test

# Protected RAG evaluation artifacts (may contain retrieved HR/Finance text)
artifacts/
rag-evaluation-report.json
*predictions.jsonl

# Logs
logs/
*.log

# Node / Frontend
node_modules/
frontend/dist/
frontend/.cache/
.pnpm-store/

# Data directories (user uploads) — customer documents never belong in git
data/
backend/data/

# Private corpus and evaluation data. The repository is public: golden sets,
# knowledge-base documents and corpus dumps live in the protected evaluation
# store and are passed to the runners by path (see backend/app/evaluation/README.md).
backend/evals/test_evals/
*inventory*.csv

# Local one-off maintenance scripts
backend/check_module1_before.py
backend/export_corpus_inventory.py
backend/pre_reprocess_snapshot.py
backend/retrieval_smoke.py
backend/retrieval_smoke_test.py
backend/validate_module1.py
backend/validate_reprocess.py
backend/verify_schema.py

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Compiled / binary
*.pyc
*.pyo

# Alembic
# backend/alembic/versions/

# Production config docs:
backend/app/core/prod_config.txt
backend/Dockerfile.txt
backend/prod_alembic.txt
frontend/Prod_Docker.txt
frontend/Prod_nginx.txt
backend/docs/

# llm_service.txt (old draft)
backend/app/services/generation/llm_service.txt
