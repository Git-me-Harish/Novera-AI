# Copy to .env and replace every placeholder before starting Docker.

POSTGRES_USER=novera_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=novera_db
REDIS_PASSWORD=replace-with-a-different-long-random-password
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password

# Application database/Redis URLs for local non-Docker execution.
DATABASE_URL=postgresql+asyncpg://novera_user:replace-with-a-long-random-password@localhost:5432/novera_db
REDIS_URL=redis://:replace-with-a-different-long-random-password@localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters

# ── AI models ───────────────────────────────────────────────────────────
# Any provider: openai, azure_openai, anthropic, gemini, mistral, groq,
# together, deepseek, xai, openrouter, fireworks, cohere, jina, voyage,
# ollama, vllm, lmstudio, openai_compatible. No model is built in: choose one.
# Org admins can override the chat model per organization in AI settings.

# Chat / answer generation
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Only for self-hosted or proxied endpoints, e.g. http://localhost:11434/v1
LLM_BASE_URL=
# Optional, tried in order when the primary fails: provider:model,provider:model
LLM_FALLBACK_MODELS=
# Optional cheaper model for titles and suggestions (same provider as LLM_PROVIDER)
LLM_UTILITY_MODEL=

# Embeddings. EMBEDDING_DIMENSIONS must equal the chunks.embedding column
# (1536). Changing the model or size requires re-embedding every document.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
# Adapter options as JSON, e.g. {"input_type_param": "input_type"} for Voyage
EMBEDDING_OPTIONS={}

# Reranking: cohere, jina, voyage or openai_compatible; "none" disables it.
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_BASE_URL=

# Shared provider keys, used by fallbacks and by tenant settings that pick
# a provider without supplying their own key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=

# Encrypts tenant-supplied API keys at rest (defaults to a key derived
# from SECRET_KEY). Rotating it makes stored tenant keys unreadable.
AI_SECRETS_KEY=
# Allow tenant model endpoints on private networks (on-prem only).
AI_ALLOW_PRIVATE_TENANT_ENDPOINTS=false

# Cost estimates, USD per million tokens, keyed by provider:model.
# Unpriced models report cost as unknown rather than a guess.
LLM_PRICING={}

# Offline evaluation judge (defaults to LLM_PROVIDER/LLM_MODEL)
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL=
DEFAULT_ADMIN_PASSWORD=replace-with-a-long-random-password
DEFAULT_ADMIN_EMAIL=admin@example.invalid
