# ═════════════════════════════════════════════════════════════════════════════
# Novera — environment template. Copy to .env and fill in the blanks.
#
# One entry per setting. Read by the backend (pydantic-settings) and by
# docker compose. Never commit the real .env.
#
# ► YOU FILL IN: every line marked  [KEY]  (left empty on purpose).
# ═════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Novera AI Knowledge Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Docker services (docker-compose.yml reads these) ─────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=novera_postgres
POSTGRES_PORT=5432
REDIS_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# ── Connections for running the backend on your machine ──────────────────────
# Inside Docker, compose overrides both with the container hostnames.
# Host ports are the published ones: Postgres 5433, Redis 6380.
# Passwords are URL-encoded here (a raw "@" breaks the URL).
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<url-encoded POSTGRES_PASSWORD>@localhost:5433/<POSTGRES_DB>
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://:<url-encoded REDIS_PASSWORD>@localhost:6380/0
REDIS_CACHE_TTL=3600

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=
#   generate: python -c "import secrets; print(secrets.token_hex(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Encrypts organizations' own model API keys at rest. Empty = derived from
# SECRET_KEY. Set it (python -c "import secrets; print(secrets.token_urlsafe(32))")
# to rotate SECRET_KEY without losing stored tenant keys.
AI_SECRETS_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# AI — answers: Google Gemini · embeddings + reranking: Cohere
# ═════════════════════════════════════════════════════════════════════════════

# Provider keys. LLM_/EMBEDDING_/RERANK_API_KEY below fall back to these.
GEMINI_API_KEY=
#   [KEY] Google AI Studio key (needs billing/credits)
COHERE_API_KEY=
#   [KEY] Cohere production key (trial keys are rate-limited to a few calls/min)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#   Optional: only for fallback models or organizations choosing those providers.

# Answer generation
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=
# Tried in order when the main model fails, e.g. gemini:gemini-2.5-flash-lite
LLM_FALLBACK_MODELS=
# Cheaper model for titles and follow-up suggestions; empty = LLM_MODEL.
LLM_UTILITY_MODEL=
# Gemini 2.5 thinking tokens: 0 = off where allowed (Pro uses its minimum), -1 = model default.
LLM_THINKING_BUDGET=0

# Embeddings — must match the database vector column (1536).
# Switching from Gemini to Cohere means every chunk is re-embedded (Phase 5).
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_OPTIONS={}
EMBEDDING_CACHE_TTL_SECONDS=3600

# Reranking ("none" disables it deliberately)
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-english-v3.0
RERANK_API_KEY=
RERANK_BASE_URL=

# Offline evaluation judge (never on the request path). Stronger than the
# answering model to limit self-preference bias.
EVAL_JUDGE_PROVIDER=gemini
EVAL_JUDGE_MODEL=gemini-2.5-pro

# Cost tracking: JSON price table (see app/services/ai/pricing.py). {} = unknown.
LLM_PRICING={}
# Allow organizations to point at private-network models (e.g. on-prem Ollama).
AI_ALLOW_PRIVATE_TENANT_ENDPOINTS=false

# Generation limits
TEMPERATURE=0.0
MAX_RESPONSE_TOKENS=800
MAX_CONTEXT_TOKENS=12000
LLM_MAX_CONCURRENCY=4
LLM_ANSWER_TIMEOUT_SECONDS=12
LLM_ATTEMPT_TIMEOUT_SECONDS=6

# ── Document processing ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,doc,pptx,xlsx,xls,csv,md,markdown,html,htm,txt
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
# Scanned PDF pages are read with Tesseract (in the Docker image). Languages: Tesseract codes joined by "+", e.g. eng+hin.
OCR_ENABLED=True
OCR_LANGUAGES=eng
OCR_DPI=300
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_TABLE_TOKENS=2000
MIN_CHUNK_SIZE=100
DOCUMENT_QUEUE_MAX_ATTEMPTS=5
DOCUMENT_QUEUE_RETRY_BASE_SECONDS=30
DOCUMENT_QUEUE_RETRY_MAX_SECONDS=900

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=30
RERANK_TOP_K=12
SIMILARITY_THRESHOLD=0.3
HYBRID_ALPHA=0.7
MIN_RERANK_SCORE=0.2
FOCUSED_CONTEXT_CHUNKS=6
COMPLEX_CONTEXT_CHUNKS=10
# Evidence per answer in tokens (chunks vary in size); the *_CHUNKS values cap the passage count.
FOCUSED_CONTEXT_TOKENS=2000
COMPLEX_CONTEXT_TOKENS=3500
GLOBAL_SEARCH_TOP_K=20
SCOPED_SEARCH_TOP_K=12
ENABLE_DYNAMIC_SCOPE=True
MIN_RELEVANCE_FOR_SCOPED_SEARCH=0.5
ENABLE_LLM_CLASSIFICATION=True
CLASSIFICATION_CACHE_TTL=3600
# Answer cache for near-identical questions (per organization).
SEMANTIC_CACHE_ENABLED=True
SEMANTIC_CACHE_TTL_SECONDS=300
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.96

# ── Conversation context ─────────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=2
CONVERSATION_PROMPT_TURNS=2
CONTEXT_TIMEOUT_HOURS=1
CONTEXT_MAX_DOCUMENTS=5
CONTEXT_BOOST_FACTOR=1.5
ENABLE_QUERY_REFORMULATION=True
DOCUMENT_SCOPE_MESSAGE_THRESHOLD=5
ENABLE_CONTEXT_UI=True
CONVERSATION_AUTO_TITLE=True
CONVERSATION_DELETE_RETENTION_DAYS=30

# ── Guardrails ───────────────────────────────────────────────────────────────
ENABLE_INPUT_GUARDRAILS=True
ENABLE_OUTPUT_GUARDRAILS=True
HALLUCINATION_THRESHOLD=0.3

# ── Tenancy ──────────────────────────────────────────────────────────────────
REGISTRATION_MODE=invite_only
INVITATION_EXPIRE_DAYS=7
AUDIT_RETENTION_DAYS=365
ORG_RATE_LIMIT_CHAT_PER_MINUTE=600
ORG_RATE_LIMIT_UPLOAD_PER_MINUTE=60
ORG_RATE_LIMIT_API_PER_MINUTE=3000
ORG_CHAT_MESSAGES_PER_DAY=0
# Reverse proxies in front of the API (0 locally, 1 on Render).
TRUSTED_PROXY_HOPS=0

# First super admin, created on an empty database.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# ── Email (invitations, verification, password reset) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
#   [KEY] for Gmail: an App Password, not the account password
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Novera AI
SMTP_USE_TLS=True
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:5173

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/novera.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
